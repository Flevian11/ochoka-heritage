APP_NAME=Ochoka Heritage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ochoka_heritage
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.yaliid.cloud
MAIL_PORT=587
MAIL_USERNAME=info@yaliid.cloud
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@yaliid.cloud
MAIL_FROM_NAME="Learn With Flevian LMS"
MAIL_REPLY_TO_ADDRESS=info@lwf.yaliid.cloud
MAIL_REPLY_TO_NAME="Learn With Flevian Support"
EMAIL_SUBJECT_PREFIX="[Learn With Flevian]"

JBS_SMS_ENDPOINT=https://sms.jbs.co.ke/api/v1/
JBS_SMS_API_KEY=
JBS_SMS_TIMEOUT=15
JBS_SMS_FROM_NAME="Ochoka Heritage"

AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_SEND_COOLDOWN_SECONDS=60

VITE_APP_NAME="${APP_NAME}"
